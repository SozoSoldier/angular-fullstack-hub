# Stage 1: Build the Angular source files using Node.js
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .
RUN npx ng build --configuration=production

# Stage 2: Serve the compiled static assets using Nginx
FROM nginx:alpine
COPY --from=build /app/dist/*/browser /usr/share/nginx/html

# FIXED FOR RENDER: Copy config into the templates folder.
# Nginx will automatically substitute $BACKEND_URL and output to default.conf on boot.
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
