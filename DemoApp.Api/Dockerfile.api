# Stage 1: Build the backend project using the official lightweight SDK
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# FIXED FOR CLOUD DEPLOYMENT: Explicitly pull project files from the subfolder
COPY ["DemoApp.Api/DemoApp.Api.csproj", "DemoApp.Api/"]
RUN dotnet restore "DemoApp.Api/DemoApp.Api.csproj"

# Copy the rest of the backend files and publish a compiled release bundle
COPY DemoApp.Api/ DemoApp.Api/
WORKDIR "/src/DemoApp.Api"
RUN dotnet publish "DemoApp.Api.csproj" -c Release -o /app/publish

# Stage 2: Serve the binary via the small runtime mirror
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# FIXED FOR RENDER: Remove hardcoded 8080 environment variables.
# This forces ASP.NET Core to automatically look for and bind to Render's dynamic $PORT variable instead.
ENV ASPNETCORE_URLS=http://+:10000

ENTRYPOINT ["dotnet", "DemoApp.Api.dll"]